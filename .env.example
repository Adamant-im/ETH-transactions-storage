# Standalone and systemd settings. Remove this block when the file is used only by Compose.
DB_NAME=index

ETH_URL=http://127.0.0.1:8545

# Shared indexer settings used by standalone, systemd, and Docker Compose runs.
# First block used only when both the transaction table and sync state are empty.
START_BLOCK=1

# Number of newest blocks excluded from indexing until they receive confirmations.
CONFIRMATIONS_BLOCK=0

# Delay in seconds between synchronization passes.
PERIOD=20

# Optional log file path. Leave empty to log to stdout.
LOG_FILE=

# Enable storing only transactions related to addresses from ADDRESS_FILTER_FILE.
ADDRESS_FILTER_ENABLED=false

# One Ethereum address per line. Standalone relative paths are resolved from this repository.
ADDRESS_FILTER_FILE=filter/addresses.txt

# Docker Compose-only settings. Remove this block from systemd environment files.
# Published indexer image. Pin an immutable version tag for production, for example
# ghcr.io/adamant-im/eth-transactions-storage:2.5.0
ETH_INDEXER_IMAGE=ghcr.io/adamant-im/eth-transactions-storage:latest

POSTGRES_DB=app_db
POSTGRES_USER=app_user
# Use only URL-safe letters, digits, period, underscore, tilde, or hyphen; avoid $ interpolation.
POSTGRES_PASSWORD=replace-with-a-strong-password

# PostgREST public read-only API settings. Docker Compose constructs PGRST_DB_URI internally.
PGRST_DB_SCHEMA=public
PGRST_DB_ANON_ROLE=web_anon
PGRST_DB_MAX_ROWS=10000
PGRST_OPENAPI_SERVER_PROXY_URI=http://127.0.0.1:3000

# Ethereum RPC endpoint used inside Docker Compose.
DOCKER_ETH_URL=ws://publicnode:8546
