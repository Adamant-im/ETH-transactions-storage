  "description": "Ethereum native and ERC-20 transaction indexer and storage in PostgreSQL with PostgREST API",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "format": "prettier . --write",
    "format:check": "prettier . --check",
