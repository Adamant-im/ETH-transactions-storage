    "web3",
    "crypto",
    "cryptocurrency",
    "transactions",
    "storage",
    "decentralization",
    "privacy",
    "security",
    "wallet"
  ],
  "author": "ADAMANT community developers <devs@adamant.im>, ADAMANT Foundation <devs@adamant.im>, ADAMANT Tech Labs <devs@adamant.im>",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adamant-im/ETH-transactions-storage.git"
  },
  "bugs": {
    "url": "https://github.com/Adamant-im/ETH-transactions-storage/issues"
  },
  "homepage": "https://github.com/Adamant-im/ETH-transactions-storage#readme",
  "devDependencies": {
    "markdownlint-cli": "^0.49.1",
    "prettier": "^3.5.0"
  }
