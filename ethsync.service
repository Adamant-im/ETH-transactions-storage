# Systemd service unit for Ethereum Transactions Storage indexer
# Copy to /etc/systemd/system/ethsync.service
# Adjust User, Group, WorkingDirectory, and Environment variables as needed

[Unit]
Description=Ethereum Transactions Storage Indexer
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=api_user
Group=api_user
WorkingDirectory=/home/api_user/ETH-transactions-storage
ExecStart=/usr/bin/python3 /home/api_user/ETH-transactions-storage/ethsync.py
EnvironmentFile=/home/api_user/ETH-transactions-storage/.env
Restart=on-failure
RestartSec=30
TimeoutSec=300

[Install]
WantedBy=multi-user.target
